# Safe local defaults. Copy to .env; never add real credentials to version control.
POLIBOT_EXECUTION_MODE=paper
POLIBOT_LIVE_TRADING_ENABLED=false
POLIBOT_DATABASE_URL=postgresql+asyncpg://polibot:polibot@postgres:5432/polibot
POLIBOT_LOG_LEVEL=INFO
POLIBOT_STALE_BOOK_AFTER_SECONDS=5
POLIBOT_MINIMUM_NET_EDGE=0.005
POLIBOT_MAXIMUM_ORDER_NOTIONAL=100
POLIBOT_MAXIMUM_GLOBAL_EXPOSURE=1000

